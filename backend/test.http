    "email": "carlos@gmail.com",
    "senha": "123"
}

### 6. Testar a listagem de todos os Clientes
GET http://localhost:3000/clientes
Authorization: {{loginReq.response.body.token}}

### 7. Testar a consulta de Clientes por nome
GET http://localhost:3000/cliente/buscarNome/Ana
Authorization: {{loginReq.response.body.token}}

### 8. Testar a consulta de clientes por id
GET http://localhost:3000/cliente/3
